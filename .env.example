# Database
DATABASE_URL=postgresql://user:password@localhost:5432/workflow_builder

# Better Auth
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000

# Whop OAuth (required)
WHOP_CLIENT_ID=your-whop-client-id
WHOP_CLIENT_SECRET=your-whop-client-secret
WHOP_RESOURCE_ID=your-whop-resource-id
WHOP_COMMUNITY_URL=https://whop.com/your-community/

# Whop app-level affiliate data
WHOP_API_KEY=your-whop-api-key
WHOP_COMPANY_ID=your-whop-company-id
WHOP_AFFILIATE_BASE_URL=https://whop.com/your-community/?a=

# Optional: Vercel OAuth (required only for AI Gateway managed keys)
VERCEL_CLIENT_ID=your-vercel-client-id
VERCEL_CLIENT_SECRET=your-vercel-client-secret

# Credentials Encryption
INTEGRATION_ENCRYPTION_KEY=your-64-character-hex-string

# AI
AI_GATEWAY_API_KEY=your-ai-gateway-api-key
AI_GENERATION_MODEL=anthropic/claude-haiku-4.5
OPENCODE_CHAT_MODEL=anthropic/claude-sonnet-4-5

# Platform-managed NotebookLM service
NOTEBOOKLM_SERVICE_URL=http://localhost:8000
NOTEBOOKLM_SERVICE_TOKEN=your-notebooklm-service-token

# App URL
WORKFLOW_APP_URL=http://localhost:3000
