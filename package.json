{
  "name": "ai-workflow-builder-template",
  "version": "0.1.0",
  "packageManager": "pnpm@10.29.2",
  "private": true,
  "license": "Apache-2.0",
  "description": "A template for building your own AI-driven workflow automation platform",
  "scripts": {
    "dev": "pnpm discover-plugins && next dev",
    "build": "tsx scripts/migrate-prod.ts && pnpm discover-plugins && next build --webpack",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "check": "npx ultracite@latest check",
    "fix": "npx ultracite@latest fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "echo '⚠ db:push is disabled (hangs on Supabase). Use: pnpm db:generate && pnpm db:migrate' && exit 1",
    "db:studio": "drizzle-kit studio",
    "discover-plugins": "tsx scripts/discover-plugins.ts",
    "create-plugin": "tsx scripts/create-plugin.ts",
    "skill:update-actions": "tsx scripts/export-skill-actions.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
